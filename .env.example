# Configuração de Provedor de LLM para o Agente Empório da Música
# Provedores suportados: openai, groq, gemini (via endpoint OpenAI compatível ou nativo)

# OpenAI
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# Groq (Opcional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Configurações do Agente
AGENT_TEMPERATURE=0.2
REFERENCE_DATE=2026-03-25
